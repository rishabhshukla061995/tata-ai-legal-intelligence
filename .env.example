# Copy this file to .env and fill in your values.

# ---- LLM (pick one) ----
LLM_PROVIDER=groq                 # groq = cloud (free key) | ollama = offline on your laptop
GROQ_API_KEY=your_groq_api_key_here   # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
# Offline mode: install Ollama (https://ollama.com), run `ollama pull llama3.2`, then set LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# ---- Hindi / Marathi documents (optional) ----
# The default embedding model understands English. For Hindi/Marathi contracts, uncomment:
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Email reminders (optional) ----
# Gmail: turn on 2-step verification, create an App Password, and use it below.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
